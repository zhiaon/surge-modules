[Script]
提取 cloud.189.cn Cookie = type=http-request, pattern=^https:\/\/api\.cloud\.189\.cn\/open\/user\/getUserInfo\.action, script-path=https://github.com/androidcn/userscripts/raw/refs/heads/main/cloud189_cookie.js

[MITM]
hostname = %APPEND% h5.cloud.189.cn

