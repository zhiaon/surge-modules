#!name=Weibo
#!desc=Weibo app removes ad.

[Script]
weibo_comment = type=http-response, pattern=^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/comments/build_comments\?, script-path=https://raw.githubusercontent.com/yjqiang/surge_scripts/main/scripts/weibo/weibo_comment.js, requires-body=true, max-size=0

weibo_statuses = type=http-response, pattern=^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/(statuses/unread_hot_timeline|statuses/friends/timeline|video/tiny_stream_video_list|statuses/unread_friends_timeline)\?, script-path=https://raw.githubusercontent.com/yjqiang/surge_scripts/main/scripts/weibo/weibo_statuses.js, requires-body=true, max-size=0

weibo_cardlist = type=http-response, pattern=^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/(searchall|page)\?, script-path=https://raw.githubusercontent.com/yjqiang/surge_scripts/main/scripts/weibo/weibo_cardlist.js, requires-body=true, max-size=0

weibo_cardlist_discover = type=http-response, pattern=^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/cardlist\?, script-path=https://raw.githubusercontent.com/yjqiang/surge_scripts/main/scripts/weibo/weibo_cardlist_discover.js, requires-body=true, max-size=0

weibo_statuses_extend = type=http-response, pattern=^https://(api\.weibo\.cn|mapi\.weibo\.com)/2/statuses/extend\?, script-path=https://raw.githubusercontent.com/yjqiang/surge_scripts/main/scripts/weibo/weibo_statuses_extend.js, requires-body=true, max-size=0

weibo_sdkad = type=http-response, pattern=^https://sdkapp\.uve\.weibo\.com/interface/sdk/sdkad\.php$, script-path=https://raw.githubusercontent.com/yjqiang/surge_scripts/main/scripts/weibo/weibo_sdkad.js, requires-body=true, max-size=0

[MITM]
hostname = %APPEND% api.weibo.cn, mapi.weibo.com, sdkapp.uve.weibo.com

