#!name=JD historical price
#!desc=https://github.com/yichahucha/surge

[Script]
jd_price_lite = type=http-response, pattern=^https?://api\.m\.jd\.com/(client\.action|api)\?(?:[^#?&]+&)*functionId=(wareBusiness|serverConfig|basicConfig|lite_wareBusiness|pingou_item), script-path=https://raw.githubusercontent.com/yichahucha/surge/master/jd_price_lite.js, requires-body=true

[MITM]
hostname = %APPEND% api.m.jd.com

