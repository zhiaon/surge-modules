#!name=叮咚买菜
#!desc=叮咚买菜每日自动签到&养鱼
#!system=ios

[Script]
flyertea.cookie = type=http-request, pattern=^https:\/\/www\.flyert\.com\/source\/plugin\/mobile\/mobile\.php\?(?:[^#?&]+&)*module=getdata&.*, script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/flyertea/flyertea.cookie.js

flyertea = type=cron, cronexp=10 0 0 * * *, script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/flyertea/flyertea.js

[MITM]
hostname = %APPEND% www.flyert.com

