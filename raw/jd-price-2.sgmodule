#!name=京东比价
#!desc=京东历史价格
#!system=ios

[Script]
# > 京东比价
jd_price = type=http-response, pattern=^https?:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=(wareBusiness|serverConfig|basicConfig), script-path=https://raw.githubusercontent.com/zwf234/rules/master/js/jd_price.js, requires-body=true

[MITM]
hostname = %APPEND% api.m.jd.com

