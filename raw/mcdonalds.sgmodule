#!name=麥當勞自動簽到
#!desc=每天早上自動簽到 + 參加活動。 v20220722

[Script]
mcdonalds_checkin = type=cron, cronexp=13 0 * * *, script-path=https://kinta.ma/surge/scripts/mcdonalds_checkin.js, timeout=5, wake-system=1

mcdonalds_luckydraw = type=cron, cronexp=14 0 * * *, script-path=https://kinta.ma/surge/scripts/mcdonalds_luckydraw.js, timeout=10, wake-system=1

mcdonalds_question = type=cron, cronexp="14 0 * * 3,6", script-path=https://kinta.ma/surge/scripts/mcdonalds_question.js, timeout=10, wake-system=1

mcdonalds_media_checkin = type=cron, cronexp="15 0 * * 3,6", script-path=https://kinta.ma/surge/scripts/mcdonalds_media_checkin.js, timeout=30, wake-system=1

