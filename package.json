{
  "name": "surge-modules",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An independent platform to discover, collect and manage Surge modules.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "dev:site": "wrangler dev -c workers/site/wrangler.toml --port 8787",
    "dev:proxy": "wrangler dev -c workers/module-proxy/wrangler.toml --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply surge-modules --local -c workers/site/wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply surge-modules --remote -c workers/site/wrangler.toml --env production",
    "db:seed:dev": "wrangler d1 execute surge-modules --local -c workers/site/wrangler.toml --file database/seed-dev.sql",
    "deploy:site": "wrangler deploy -c workers/site/wrangler.toml --env production",
    "deploy:proxy": "wrangler deploy -c workers/module-proxy/wrangler.toml --env production",
    "dev:local": "sh scripts/serve-local.sh",
    "dev:local:build": "node node_modules/vite/bin/vite.js build && node scripts/dev-api.mjs",
    "build:workers": "node scripts/build-workers.mjs",
    "check:secrets": "sh scripts/check-no-secrets.sh",
    "verify:deploy": "sh scripts/verify-deploy.sh",
    "build:static": "vite build && python3 scripts/build_data.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.545.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "wrangler": "^4.158.0"
  }
}