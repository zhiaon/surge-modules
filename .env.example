# Copy to `.dev.vars` for local `wrangler dev`.
# Real values live only in Cloudflare (wrangler secret put) — never commit them.

# GitHub token used by the sync pipeline (read-only, fine-grained, one repo each)
GITHUB_TOKEN=

# Shared secret for GitHub webhooks (HMAC verification)
WEBHOOK_SECRET=

# Local-only overrides
ENVIRONMENT=development
